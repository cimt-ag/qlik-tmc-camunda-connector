{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "TMC outbound connector",
  "id": "io.camunda.cimt.qlik-tmc-outbound-connector.v1",
  "version": 1,
  "description": "A connector to manage and execute tasks and plans of the tmc",
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:Task"
  ],
  "elementType": {
    "value": "bpmn:ServiceTask"
  },
  "engines": {
    "camunda": "^8.8"
  },
  "groups": [
    {
      "id": "connector",
      "label": "Connector"
    },
    {
      "id": "authentication",
      "label": "Authentication"
    },
    {
      "id": "endpoint",
      "label": "Endpoint"
    },
    {
      "id": "payload",
      "label": "Payload"
    },
    {
      "id": "output",
      "label": "Output Mapping"
    },
    {
      "id": "error",
      "label": "Error Mapping"
    }
  ],
  "properties": [
    {
      "value": "io.camunda:cimt-qlik-tmc-outbound-connector",
      "type": "Hidden",
      "binding": {
        "property": "type",
        "type": "zeebe:taskDefinition"
      }
    },
    {
      "id" : "id",
      "label" : "ID",
      "description" : "ID of the element template",
      "value" : "io.camunda.cimt_qlik_tmc_outbound_connector.v1",
      "group" : "connector",
      "binding" : {
        "key" : "elementTemplateId",
        "type" : "zeebe:taskHeader"
      },
      "type" : "Hidden"
    },
    {
      "id": "authentication.authenticationType",
      "label": "Credentials Type",
      "description": "Choose the Credential type you want to use",
      "optional": false,
      "type": "Dropdown",
      "group": "authentication",
      "value": "bearerToken",
      "choices": [
        {
          "name": "base64 encoded secret",
          "value": "base64"
        },
        {
          "name": "Service Account Credentials Set",
          "value": "credentialsSet"
        },
        {
          "name": "Bearer Token",
          "value": "bearerToken"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "authentication.authenticationType"
      }
    },
    {
      "id": "authentication.serviceAccountId",
      "label": "Client ID",
      "description": "Your service account's ID to connect to the TMC",
      "optional": false,
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "authentication.authenticationType",
        "equals": "credentialsSet",
        "type": "simple"
      },
      "feel": "optional",
      "group": "authentication",
      "binding": {
        "name": "authentication.serviceAccountId",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "authentication.accountSecret",
      "label": "Account secret",
      "description": "Your service account's secret to connect to the TMC",
      "optional": false,
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "authentication.authenticationType",
        "equals": "credentialsSet",
        "type": "simple"
      },
      "feel": "optional",
      "group": "authentication",
      "binding": {
        "name": "authentication.accountSecret",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "authentication.base64Credentials",
      "label": "Base64 Credentials",
      "description": "Base64 encoded credentials to provide the service account credentials - please provide either this base64 encoded secret or the accounts id and accounts secret",
      "optional": false,
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "authentication.authenticationType",
        "equals": "base64",
        "type": "simple"
      },
      "feel": "optional",
      "group": "authentication",
      "binding": {
        "name": "authentication.base64Credentials",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "authentication.bearerToken",
      "label": "Bearer Token",
      "description": "Bearer Token credentials to authenticate to the TMC (personal access token)",
      "optional": false,
      "constraints": {
        "notEmpty": true
      },
      "condition": {
        "property": "authentication.authenticationType",
        "equals": "bearerToken",
        "type": "simple"
      },
      "feel": "optional",
      "group": "authentication",
      "binding": {
        "name": "authentication.bearerToken",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "endpoint.entity",
      "label": "TMC Entity",
      "description": "Choose the Entity to use",
      "optional": false,
      "type": "Dropdown",
      "group": "endpoint",
      "value": "task",
      "choices": [
        {
          "name": "Task",
          "value": "task"
        },
        {
          "name": "Plan",
          "value": "plan"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "endpoint.entity"
      }
    },
    {
      "id": "endpoint.region",
      "label": "TMC Region",
      "description": "Choose the Region of the TMC",
      "optional": false,
      "type": "Dropdown",
      "group": "endpoint",
      "value": "europe",
      "choices": [
        {
          "name": "AWS Europe Region",
          "value": "europe"
        },
        {
          "name": "AWS Asia Pacific Region",
          "value": "pacific"
        },
        {
          "name": "AWS United States East Region",
          "value": "us_east"
        },
        {
          "name": "Azure United States West Region",
          "value": "us_west"
        },
        {
          "name": "AWS Australia Region",
          "value": "australia"
        }
      ],
      "binding": {
        "type": "zeebe:input",
        "name": "endpoint.region"
      }
    },
    {
      "id": "operation",
      "label": "TMC Task API",
      "description": "Choose the Task API to use",
      "optional": false,
      "type": "Dropdown",
      "group": "endpoint",
      "value": "getTasks",
      "condition": {
        "property": "endpoint.entity",
        "equals": "task",
        "type": "simple"
      },
      "choices": [
        {
          "name": "Get available Tasks",
          "value": "getTasks"
        },
        {
          "name": "Get Task Executions",
          "value": "getTaskExecutions"
        },
        {
          "name": "Get available Tasks Executions",
          "value": "getAvailableTasksExecutions"
        },
        {
          "name": "Get Task by ID",
          "value": "getTaskById"
        },
        {
          "name": "Execute Task",
          "value": "executeTask"
        },
        {
          "name": "Get Task execution status",
          "value": "getTaskExecutionStatus"
        },
        {
          "name": "Terminate Task Execution",
          "value": "terminateTaskExecution"
        }
      ],
      "binding": {
        "type": "zeebe:taskHeader",
        "key": "operation"
      }
    },
    {
      "id": "getTaskExecutionStatus:executionId",
      "label": "execution ID",
      "description": "Execution Id to query",
      "optional": false,
      "feel": "optional",
      "group": "payload",
      "condition": {
        "property": "operation",
        "equals": "getTaskExecutionStatus",
        "type": "simple"
      },
      "binding": {
        "name": "getTaskExecutionStatus_executionId",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "getTaskExecutions:taskId",
      "label": "Task ID",
      "description": "Task Id to query",
      "optional": false,
      "feel": "optional",
      "group": "payload",
      "condition": {
        "property": "operation",
        "equals": "getTaskExecutions",
        "type": "simple"
      },
      "binding": {
        "name": "getTaskExecutions_taskId",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "getTaskById:taskId",
      "label": "Task ID",
      "description": "Task Id to get the task",
      "optional": false,
      "feel": "optional",
      "group": "payload",
      "condition": {
        "property": "operation",
        "equals": "getTaskById",
        "type": "simple"
      },
      "binding": {
        "name": "getTaskById_taskId",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "terminateTaskExecution:executionId",
      "label": "Execution ID to terminate the task execution",
      "description": "Execution ID to terminate Execution",
      "optional": false,
      "feel": "optional",
      "group": "payload",
      "condition": {
        "property": "operation",
        "equals": "terminateTaskExecution",
        "type": "simple"
      },
      "binding": {
        "name": "terminateTaskExecution_executionId",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "offset",
      "label": "Offset in Seconds",
      "description": "Offset to start the task execution monitoring",
      "optional": true,
      "value": "60",
      "feel": "optional",
      "group": "payload",
      "condition": {
        "property": "operation",
        "equals": "executeTask",
        "type": "simple"
      },
      "binding": {
        "name": "offset",
        "type": "zeebe:input"
      },
      "type": "Number"
    },
    {
      "id": "period",
      "label": "Period in Seconds",
      "description": "Period to check the Status of the task execution",
      "optional": true,
      "value": "60",
      "feel": "optional",
      "group": "payload",
      "condition": {
        "property": "operation",
        "equals": "executeTask",
        "type": "simple"
      },
      "binding": {
        "name": "period",
        "type": "zeebe:input"
      },
      "type": "Number"
    },
    {
      "id": "limit",
      "label": "Limit to check Status",
      "description": "How many attempts for checking the status of the task execution",
      "optional": true,
      "value": "100",
      "feel": "optional",
      "group": "payload",
      "condition": {
        "property": "operation",
        "equals": "executeTask",
        "type": "simple"
      },
      "binding": {
        "name": "limit",
        "type": "zeebe:input"
      },
      "type": "Number"
    },
    {
      "id": "payload.queryParameters",
      "label": "Query parameters",
      "description": "Map of query parameters to add to the request URL",
      "optional": true,
      "feel": "required",
      "group": "payload",
      "binding": {
        "name": "payload.queryParameters",
        "type": "zeebe:input"
      },
      "type": "String"
    },
    {
      "id": "payload.body",
      "label": "Request body",
      "description": "Payload to send with the request",
      "optional": true,
      "feel": "optional",
      "group": "payload",
      "binding": {
        "name": "payload.body",
        "type": "zeebe:input"
      },
      "type": "Text"
    },
    {
      "id": "resultVariable",
      "label": "Result variable",
      "description": "Name of variable to store the response in",
      "group": "output",
      "binding": {
        "key": "resultVariable",
        "type": "zeebe:taskHeader"
      },
      "type": "String"
    },
    {
      "id": "resultExpression",
      "label": "Result expression",
      "description": "Expression to map the response into process variables",
      "feel": "required",
      "group": "output",
      "binding": {
        "key": "resultExpression",
        "type": "zeebe:taskHeader"
      },
      "type": "Text"
    },
    {
      "id": "errorExpression",
      "label": "Error expression",
      "description": "Expression to handle errors. Details in the <a href=\"https://docs.camunda.io/docs/components/connectors/use-connectors/\" target=\"_blank\">documentation</a>.",
      "feel": "required",
      "group": "error",
      "value": "if is defined(error) then bpmnError(error.code, error.message) else null",
      "binding": {
        "key": "errorExpression",
        "type": "zeebe:taskHeader"
      },
      "type": "Text"
    }
  ],
  "icon": {
    "contents": "data:image/png;base64,"
  }
}